# Server Configuration
HOST=0.0.0.0
PORT=8000
APP_ENV=development
AI_SERVER_API_KEY=dev-key-please-change-in-env

# Production must set APP_ENV=production and use a unique, non-placeholder key.
RATE_LIMIT_START=30/minute
RATE_LIMIT_SUBMIT=60/minute
RATE_LIMIT_CONFIRM=60/minute
RATE_LIMIT_TRANSCRIBE=30/minute


# Firecrawl API Key crawl data
FIRECRAWL_API_KEY=

# LLM Providers API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
ELEVENLABS_API_KEY=
GLADIA_API_KEY=

# LLM Routing Configuration
# Supported values: gemini, openai, claude, local
DEFAULT_LLM_PROVIDER=local

# RAG & Database Configuration
CHROMA_DB_PATH=./chroma_db
EMBEDDING_MODEL=text-embedding-3-large
MATCHING_EMBEDDING_PROVIDER=openai
MATCHING_EMBEDDING_MODEL=text-embedding-3-large

# Local Ollama Configuration (Fallback)
LOCAL_OLLAMA_URL=http://localhost:11434
LOCAL_MODEL_NAME=llama3.2

# Voice Provider Configuration
# STT: Gladia Solaria-3 primary, local Faster-Whisper fallback
# Gladia's free plan currently includes 10 hours/month with one Live session at a time.
STT_PRIMARY_PROVIDER=gladia
STT_FALLBACK_PROVIDER=faster_whisper
FASTER_WHISPER_MODEL=base

# TTS supported values: elevenlabs, edge_tts, google, vieneu
# Eleven v3 is billed by character. The free plan currently includes 10,000
# characters/month, so Edge TTS remains the no-cost fallback for quota/errors.
TTS_PRIMARY_PROVIDER=elevenlabs
TTS_FALLBACK_PROVIDER=edge_tts
TTS_PROVIDER_TIMEOUT=120
TTS_CHUNK_CHARS=220
TTS_BATCH_CONCURRENCY=1
EDGE_TTS_TIMEOUT=15

# ElevenLabs TTS
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_VI=
ELEVENLABS_VOICE_ID_EN=

# VieNeu local TTS testing provider
# Install only when using it: pip install vieneu
# Create a read token at https://huggingface.co/settings/tokens to avoid anonymous rate limits.
HF_TOKEN=
VIENEU_SAMPLE_RATE=48000
VIENEU_VOICE_ID=
